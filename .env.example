# ── Application ──────────────────────────────────────────
APP_TITLE=Production Control
APP_ENV=development          # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=production_control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Итоговый DSN (asyncpg) — собирается из полей выше в config.py
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/production_control

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1
# REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/
# CELERY_BROKER_URL=amqp://admin:changeme@localhost:5672//

# ── MinIO (S3-compatible) ─────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false

# ── Celery ────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4
