# ── Application ──────────────────────────────────────────
APP_TITLE=Production Control
APP_ENV=development          # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=production_control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/

# DATABASE_URL, REDIS_URL, CELERY_BROKER_URL и CELERY_RESULT_BACKEND собираются
# автоматически из переменных выше — можно не указывать явно, если не нужно
# переопределить (например, задать свой DATABASE_URL напрямую).

# ── MinIO (S3-compatible) ─────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false

# ── Celery ────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=4
